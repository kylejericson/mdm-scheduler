# Copy to .env and fill in. .env is gitignored - never commit real values.

# Encrypts stored Jamf credentials AND signs session cookies.
# Generate with: openssl rand -hex 32
# Changing this makes every stored Jamf credential unreadable (re-enter them).
SECRET_KEY=

# Password for the web UI. There is no username field.
ADMIN_PASSWORD=

# Default timezone for new schedules and for dashboard timestamps.
# Per-job timezones are chosen in the UI and are unaffected by this.
TZ=UTC

# Host port the UI is published on.
PORT=8000

# Optional
# SESSION_MAX_AGE=86400   # seconds before the UI session expires
# LOG_RETENTION=500       # run-log rows kept per job
# HTTP_TIMEOUT=45         # seconds per Jamf API request

# Upgrading from jamf-scheduler: point at the existing data volume so the
# rename doesn't strand your database. Find it with: docker volume ls
# DATA_VOLUME=jamf-scheduler_jamf_scheduler_data
