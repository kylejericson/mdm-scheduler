# Copy to .env and fill in. .env is gitignored - never commit real values.

# Encrypts stored MDM credentials and TOTP secrets, and signs session cookies.
# Generate with: openssl rand -hex 32
# Changing this makes stored credentials unreadable and breaks every enrolled
# authenticator app. Back it up with your data volume.
SECRET_KEY=

# Creates the first 'admin' account on the very first boot, and stays a
# break-glass sign-in that skips MFA. Once your recovery codes are saved
# somewhere safe, turn break-glass off under Users -> Security policy.
ADMIN_PASSWORD=

# Default timezone for new schedules and for dashboard timestamps.
# Per-job timezones are chosen in the UI and are unaffected by this.
TZ=UTC

# Host port the UI is published on.
PORT=8000

# Optional
# SESSION_MAX_AGE=86400   # seconds before a session expires
# LOG_RETENTION=500       # run-log rows kept per job
# HTTP_TIMEOUT=45         # seconds per MDM API request
# AUDIT_RETENTION=10000   # audit rows kept

# Login throttling. Counted per account and per source IP over the same window:
# the account limit stops someone grinding one password, the IP limit stops a
# spray across many usernames.
# LOGIN_MAX_FAILURES=5
# IP_MAX_FAILURES=20
# LOGIN_WINDOW_SECONDS=900
# LOGIN_LOCKOUT_SECONDS=900
# RECOVERY_CODE_COUNT=10

# Passkeys bind to a domain. This defaults to the HTTPS hostname set under
# Branding, which is almost always what you want - set it only if you need a
# different one, and know that CHANGING IT INVALIDATES EVERY REGISTERED PASSKEY.
# WEBAUTHN_RP_ID=mdm.example.com
# WEBAUTHN_RP_NAME=MDM Scheduler
# WEBAUTHN_EXTRA_ORIGINS=https://mdm.example.com:8443

# Upgrading from jamf-scheduler: point at the existing data volume so the
# rename doesn't strand your database. Find it with: docker volume ls
# DATA_VOLUME=jamf-scheduler_jamf_scheduler_data

# HTTPS (Caddy sidecar). The hostname, email, challenge type and DNS token are
# set in the UI under Branding -> HTTPS; these are just the published ports.
HTTP_PORT=80
HTTPS_PORT=443
